<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    RimWorld 1.6: ConfigurePawnsXenotypes (not ConfigurePawns). Baseliner needs Biotech.
    Playtest setup ScenPart: ideo/colonist harden + campaign activate (same class of fix as Vampire Lord).
    Campaign also activates from ArkCampaignGameComponent when Find.Scenario.name == "The Ark".
  -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>TheArk_Playtest</defName>
    <label>The Ark</label>
    <description>The ship is the colony. Land. Take what you need. Do not stay too long. Leave. Do it again.\n\nPlaytest start for The Ark campaign tooling. Requires Biotech for the Baseliner starting cast (same xenotype page as Vampire Lord).</description>
    <scenario>
      <name>The Ark</name>
      <summary>Three Baseliner crew. Ark campaign activates on start.</summary>
      <description>Surface playtest start for The Ark. Use Dev Mode - The Ark (DEV) - Apply M1 Persistence Fixture to prove save/load.</description>
      <parts>

        <li Class="ScenPart_PlayerFaction">
          <def>PlayerFaction</def>
          <factionDef>PlayerColony</factionDef>
        </li>

        <li Class="ScenPart_PlanetLayerFixed">
          <def>PlanetLayerFixed</def>
          <layer>Surface</layer>
          <settingsDef>Surface</settingsDef>
          <tag>Surface</tag>
        </li>

        <li Class="ScenPart_GameStartDialog">
          <def>TheArk_GameStartDialog</def>
          <text>The ship is the colony.\n\nThree crew. Surface playtest. Campaign tools are active.\n\nDev Mode - The Ark (DEV) - Apply M1 Persistence Fixture to prove save/load.\n\n(Ideology settle page may still log a known NRE; the game should continue with a generated ideoligion.)</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>3</pawnChoiceCount>
          <xenotypeCounts>
            <li>
              <xenotype>Baseliner</xenotype>
              <count>3</count>
              <requiredAtStart>true</requiredAtStart>
              <description>Ark crew</description>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="TheArk.Scenario.ScenPart_ArkPlaytestSetup">
          <def>TheArk_PlaytestSetup</def>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>36</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>8</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>30</count>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
