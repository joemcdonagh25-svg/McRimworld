<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!--
    Minimal RimWorld 1.6 scenario (same required scaffolding as Vampire Lord).
    No custom ScenPart classes, no custom ScenPartDefs, no start dialog, no gear.
    Campaign activate: ArkCampaignGameComponent when Find.Scenario.name == "The Ark".
  -->
  <ScenarioDef ParentName="ScenarioBase">
    <defName>TheArk_Playtest</defName>
    <label>The Ark</label>
    <description>The ship is the colony. Land. Take what you need. Do not stay too long. Leave. Do it again.\n\nMinimal playtest start for The Ark campaign tooling.</description>
    <scenario>
      <name>The Ark</name>
      <summary>Three crew. Ark campaign activates on start.</summary>
      <description>Surface playtest start for The Ark. Use Dev Mode - The Ark (DEV) - Apply M1 Persistence Fixture to prove save/load.</description>
      <parts>

        <li Class="ScenPart_PlayerFaction">
          <def>PlayerFaction</def>
          <factionDef>PlayerColony</factionDef>
        </li>

        <li Class="ScenPart_PlanetLayerFixed">
          <def>PlanetLayerFixed</def>
          <layer>Surface</layer>
          <settingsDef>Surface</settingsDef>
          <tag>Surface</tag>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns">
          <def>ConfigurePawns</def>
          <pawnCount>3</pawnCount>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
