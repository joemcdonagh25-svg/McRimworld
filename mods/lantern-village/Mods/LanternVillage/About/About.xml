<?xml version="1.0" encoding="utf-8"?>
<ModMetaData>
  <name>The Lantern Village</name>
  <author>Lantern Village Project</author>
  <packageId>lanternvillage.thelanternvillage</packageId>
  <description>Scenario support mod for The Lantern Village: a Grimm-inspired folk horror hamlet. Places a prebuilt medieval woodland settlement during map generation, generates The Hearthbound ideoligion, applies the five founding colonists' roles, and drives a slow-burn horror phase controller (supernatural events disabled by default).</description>
  <supportedVersions>
    <li>1.6</li>
  </supportedVersions>
  <modDependencies>
    <li>
      <packageId>brrainz.harmony</packageId>
      <displayName>Harmony</displayName>
      <steamWorkshopUrl>steam://url/CommunityFilePage/2009463077</steamWorkshopUrl>
      <downloadUrl>https://github.com/pardeike/HarmonyRimWorld/releases/latest</downloadUrl>
    </li>
    <li>
      <packageId>OskarPotocki.VanillaFactionsExpanded.Core</packageId>
      <displayName>Vanilla Expanded Framework</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/workshop/filedetails/?id=2023507013</steamWorkshopUrl>
    </li>
    <li>
      <packageId>DankPyon.Medieval.Overhaul</packageId>
      <displayName>Medieval Overhaul</displayName>
      <steamWorkshopUrl>https://steamcommunity.com/workshop/filedetails/?id=3219596926</steamWorkshopUrl>
    </li>
  </modDependencies>
  <loadAfter>
    <li>ludeon.rimworld</li>
    <li>ludeon.rimworld.ideology</li>
    <li>ludeon.rimworld.biotech</li>
    <li>brrainz.harmony</li>
    <li>OskarPotocki.VanillaFactionsExpanded.Core</li>
    <li>syrchalis.processor.framework</li>
    <li>VanillaExpanded.VBooksE</li>
  </loadAfter>
  <!--
    Deliberately loads BEFORE Medieval Overhaul (and so before Dark Ages: Beasts and
    Monsters / World Tech Level, which themselves load after it): this mod's own Mod
    class constructor applies a Harmony finalizer patch guarding a real bug in
    MedievalOverhaul.MedievalOverhaulSettings's constructor (see
    CompatPatch_MedievalOverhaul.cs), and that patch has to be in place before
    RimWorld constructs Medieval Overhaul's own Mod class, not after. Mod class
    construction for every active mod happens in one early pass, well before
    StaticConstructorOnStartup code, which runs too late for this.
  -->
  <loadBefore>
    <li>DankPyon.Medieval.Overhaul</li>
  </loadBefore>
</ModMetaData>
