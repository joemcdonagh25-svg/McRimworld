<?xml version="1.0" encoding="utf-8"?>
<Defs>

  <!-- Playtest Keep scenario: identity + cast + gear. Courtyard + campaign auto-start via custom ScenPart. -->
  <ScenarioDef>
    <defName>VampireLord_PlaytestKeep</defName>
    <label>Vampire Lord</label>
    <description>Rule the Black Keep. One Vampire Lord and two thralls begin behind stone walls. Warnings come down the road. Prepare. Survive the wave. Repeat.\n\nTower-defence playtest scenario for Vampire Lord (M2). Requires Biotech.</description>
    <scenario>
      <name>Vampire Lord</name>
      <summary>Defend the Black Keep: 1 Vampire Lord, 2 thralls, courtyard walls, escalating raids.</summary>
      <description>You hold a lonely keep at the edge of the wilds. Mortals already whisper of torchlight on the road. The Wave Director is active — prepare the walls before the next host arrives.</description>
      <parts>

        <li Class="ScenPart_GameStartDialog">
          <text>The Black Keep is yours.\n\nOne Vampire Lord. Two thralls. Stone walls and a single gate.\n\nScouts will warn you before each host arrives. Use the time. Raise the walls. Survive the wave.\n\n(Debug actions under Vampire Lord still work if you want to force a warning or raid.)</text>
          <closeSound>GameStartSting</closeSound>
        </li>

        <li Class="ScenPart_ConfigPage_ConfigureStartingPawns_Xenotypes">
          <def>ConfigurePawnsXenotypes</def>
          <pawnChoiceCount>3</pawnChoiceCount>
          <xenotypeCounts>
            <li>
              <xenotype>Sanguophage</xenotype>
              <count>1</count>
              <requiredAtStart>true</requiredAtStart>
              <description>Vampire Lord</description>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
            <li>
              <xenotype>Baseliner</xenotype>
              <count>2</count>
              <requiredAtStart>true</requiredAtStart>
              <description>Thrall</description>
              <allowedDevelopmentalStages>Adult</allowedDevelopmentalStages>
            </li>
          </xenotypeCounts>
        </li>

        <li Class="ScenPart_PlayerPawnsArriveMethod">
          <def>PlayerPawnsArriveMethod</def>
          <method>Standing</method>
        </li>

        <!-- Courtyard + auto-start Wave Director (C#) -->
        <li Class="VampireLord.Scenario.ScenPart_VampireLordPlaytestSetup" />

        <!-- Starter gear / materials for a short tower-defence playtest -->
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MealSurvivalPack</thingDef>
          <count>36</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MedicineIndustrial</thingDef>
          <count>8</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Steel</thingDef>
          <count>200</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>WoodLog</thingDef>
          <count>150</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>BlocksGranite</thingDef>
          <count>120</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>ComponentIndustrial</thingDef>
          <count>30</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Gun_BoltActionRifle</thingDef>
          <count>2</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>MeleeWeapon_Gladius</thingDef>
          <count>1</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>Apparel_Parka</thingDef>
          <stuff>Cloth</stuff>
          <count>3</count>
        </li>
        <li Class="ScenPart_StartingThing_Defined">
          <def>StartingThing_Defined</def>
          <thingDef>HemogenPack</thingDef>
          <count>10</count>
        </li>

        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>Smithing</project>
        </li>
        <li Class="ScenPart_StartingResearch">
          <def>StartingResearch</def>
          <project>ComplexClothing</project>
        </li>

      </parts>
    </scenario>
  </ScenarioDef>

</Defs>
